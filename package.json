{
  "name": "portfolio",
  "productName": "Portfolio",
  "version": "0.1.0",
  "description": "로컬 포트 관리 + 서버 로그 + 프론트 미리보기 + Claude 명령 Electron 앱 (port + folio)",
  "main": "src/main/main.js",
  "author": "민대인",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "dist:mac": "electron-builder --mac",
    "pack": "electron-builder --dir"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "dev.portfolio.app",
    "productName": "Portfolio",
    "asar": true,
    "asarUnpack": [
      "src/mcp/**"
    ],
    "files": [
      "src/**/*",
      "!**/*.md",
      "!.playwright-mcp/**"
    ],
    "directories": {
      "output": "dist"
    },
    "mac": {
      "category": "public.app-category.developer-tools",
      "identity": null,
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ]
    },
    "dmg": {
      "title": "Portfolio ${version}"
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Development"
    }
  }
}
